---
import { getEntry, type CollectionEntry } from 'astro:content';

type PostEntry = CollectionEntry<'posts'>;
type EventEntry = CollectionEntry<'events'>;

interface ContentProps {
  content_type: 'post' | 'event';
  filename: string;
  href?: undefined;
  title?: undefined;
  body?: undefined;
}

interface LinkProps {
  href: string;
  title: string;
  body: string;
  content_type?: undefined;
  filename?: undefined;
}

type Props = ContentProps | LinkProps;

const { content_type, filename, href, title: propTitle, body } = Astro.props;

let entry: PostEntry | EventEntry | undefined = undefined;
if (content_type && filename) {
  entry = content_type === 'post'
    ? await getEntry('posts', filename)
    : await getEntry('events', filename);
}

const isContent = !!entry;

// --- Data Extraction ---
const title = isContent ? entry.data.title : propTitle;
const description = isContent ? entry.data.description : body;
const cardLink = isContent ? `/posts/${entry.slug}` : href;

// Content-only fields
const date = isContent && 'date' in entry.data ? entry.data.date : undefined;
const endDate = isContent && 'endDate' in entry.data ? entry.data.endDate : undefined;
const location = isContent && 'location' in entry.data ? entry.data.location : undefined;
const category = isContent && 'category' in entry.data ? entry.data.category : undefined;
const images = isContent && 'images' in entry.data ? entry.data.images : [];
const external_link = isContent && 'external_link' in entry.data ? entry.data.external_link : undefined;
const tags = isContent && 'tags' in entry.data ? entry.data.tags : [];
const status = isContent && 'status' in entry.data ? entry.data.status : undefined;
const featured = isContent && 'featured' in entry.data ? entry.data.featured : false;
const preview_image = isContent && 'preview_image' in entry.data ? entry.data.preview_image : undefined;


const formatDate = (date: Date) => {
  if (!date) return '';
  return date.toLocaleDateString('en-US', {
    weekday: 'long',
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};

const categoryStyles = {
  workshop: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
  social: 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200',
  conference: 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200',
  meeting: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200',
  competition: 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200',
  other: 'bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200'
};

const statusStyles = {
  upcoming: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
  completed: 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200',
  cancelled: 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200',
  draft: 'bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200',
  published: 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200'
};
---

<article class={`event-card bg-white dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden transition-all duration-300 hover:shadow-xl hover:scale-[1.02] ${featured ? 'ring-2 ring-yellow-400' : ''}`}>
  <a href={cardLink} class="absolute inset-0 z-10" aria-label={`View ${title}`}></a>

  {isContent ? (
    <>
      {/* Images */}
      {(images && images.length > 0 || preview_image) && (
        <div class="event-images">
          {preview_image ? (
            <div class="aspect-video w-full">
              <img src={preview_image} alt={title} class="w-full h-full object-cover" />
            </div>
          ) : images && images.length === 1 ? (
            <div class="aspect-video w-full">
              <img src={`/src/assets/events/${images[0]}`} alt={title} class="w-full h-full object-cover" />
            </div>
          ) : (
            <div class="grid grid-cols-2 gap-1 p-4">
              {images && images.slice(0, 4).map((image, index) => (
                <div class={`aspect-square ${images.length === 3 && index === 0 ? 'col-span-2' : ''}`}>
                  <img src={`/src/assets/events/${image}`} alt={`${title} - Image ${index + 1}`} class="w-full h-full object-cover rounded-lg" />
                </div>
              ))}
              {images && images.length > 4 && (
                <div class="aspect-square bg-gray-200 dark:bg-gray-700 rounded-lg flex items-center justify-center">
                  <span class="text-gray-600 dark:text-gray-300 font-semibold">+{images.length - 3} more</span>
                </div>
              )}
            </div>
          )}
        </div>
      )}

      <div class="p-6 relative">
        <!-- Header with badges -->
        <div class="flex flex-wrap items-center gap-2 mb-3">
          {category && (
            <span class={`px-2 py-1 text-xs font-semibold rounded-full ${categoryStyles[category as keyof typeof categoryStyles] || categoryStyles.other}`}>
              {category}
            </span>
          )}
          {status && (
            <span class={`px-2 py-1 text-xs font-semibold rounded-full ${statusStyles[status as keyof typeof statusStyles] || statusStyles.completed}`}>
              {status}
            </span>
          )}
          {featured && (
            <span class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200">
              ⭐ Featured
            </span>
          )}
        </div>

        <!-- Title -->
        <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">{title}</h3>

        <!-- Date and Location -->
        <div class="text-sm text-gray-600 dark:text-gray-300 mb-3 space-y-1">
          {date && (
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path></svg>
              <span>{formatDate(date)}{endDate && endDate.getTime() !== date.getTime() && ` - ${formatDate(endDate)}`}</span>
            </div>
          )}
          {location && (
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path></svg>
              <span>{location}</span>
            </div>
          )}
        </div>

        <!-- Description -->
        <p class="text-gray-700 dark:text-gray-300 mb-4 leading-relaxed">{description}</p>

        <!-- Tags -->
        {tags && tags.length > 0 && (
          <div class="flex flex-wrap gap-1 mb-4">
            {tags.map(tag => <span class="px-2 py-1 text-xs bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 rounded">#{tag}</span>)}
          </div>
        )}

        <!-- External Link -->
        {external_link && (
          <div class="mt-4">
            <a href={external_link} class="inline-flex items-center gap-2 text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-200 font-medium transition-colors">
              Learn More
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>
          </div>
        )}
      </div>
    </>
  ) : (
    <div class="p-6">
      <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">{title}</h3>
      <p class="text-gray-700 dark:text-gray-300">{body}</p>
    </div>
  )}
</article>

<style>
  .event-card {
    break-inside: avoid;
    position: relative;
  }
</style>